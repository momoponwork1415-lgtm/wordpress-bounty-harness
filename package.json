{
  "name": "wordpress-bounty-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "harness": "dist/cli/main.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "packageExtensions": {
      "dependency-cruiser@18.7.0": {
        "dependencies": {
          "typescript": "6.0.3"
        }
      }
    }
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "preflight:root-four": "pnpm build && node scripts/preflight-root-four.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "prettier --check . --ignore-unknown",
    "format": "prettier --write . --ignore-unknown",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:architecture": "vitest run tests/architecture/module-boundary.test.ts",
    "analyze:dependencies": "depcruise src --config .dependency-cruiser.json --output-type err",
    "analyze:unused": "knip --tsConfig tsconfig.build.json",
    "analyze:unused:production": "knip --tsConfig tsconfig.build.json --production"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "dependency-cruiser": "18.7.0",
    "knip": "6.42.1",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "zod": "^4.6.5"
  }
}
